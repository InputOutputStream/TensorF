#ifndef __MODEL__LOADER__
#define __MODEL__LOADER__

#include <string>
#include <vector>
#include <map>
#include <stdexcept>
#include <iostream>
#include <functional>

#include "../DataStructures/Matrix.hpp"
#include "../DataStructures/Tensor.hpp"
#include "../Modules/Transformer/GPT.hpp"
#include "../DataLoader/GGUF.hpp"

// ============================================================
//  Hyperparameter bundle — everything needed to instantiate GPT
// ============================================================
struct GGUFHyperParams {
    size_t vocab_size;
    size_t input_dim;       // embedding_length  (e.g. 576)
    size_t block_size;      // context_length    (e.g. 8192, crop as needed)
    size_t n_heads;         // attention.head_count  (e.g. 9)
    size_t n_kv_heads;      // attention.head_count_kv (e.g. 3)  — info only
    size_t n_layer;         // block_count       (e.g. 30)
    size_t ffn_hidden;      // feed_forward_length (e.g. 1536)
};

// ============================================================
//  Arch differences between GGUF models and your GPT
// ============================================================
//
//  SmolLM2 (llama arch) vs your GPT:
//
//  | SmolLM2 GGUF name                | Your framework parameter        | Notes                         |
//  |----------------------------------|---------------------------------|-------------------------------|
//  | token_embd.weight [576,49152]    | embedding_table.embeddings      | shape: {vocab, dim} — matches |
//  | blk.N.attn_norm.weight [576]     | blocks[N].ln1.gamma             | RMSNorm → LayerNorm gamma     |
//  | blk.N.ffn_norm.weight  [576]     | blocks[N].ln2.gamma             |                               |
//  | blk.N.attn_q.weight [576,576]    | blocks[N].mha.Heads[*].Q.weight | split across heads            |
//  | blk.N.attn_k.weight [576,192]    | blocks[N].mha.Heads[*].K.weight | GQA: fewer KV heads           |
//  | blk.N.attn_v.weight [576,192]    | blocks[N].mha.Heads[*].V.weight | GQA: fewer KV heads           |
//  | blk.N.attn_output.weight[576,576]| blocks[N].mha.proJ.weight       | projection                    |
//  | blk.N.ffn_gate.weight[576,1536]  | (SwiGLU gate — no match)        | absorbed into ffwd.l1.weight  |
//  | blk.N.ffn_up.weight  [576,1536]  | blocks[N].ffwd.l1.weight        | "up" projection               |
//  | blk.N.ffn_down.weight[1536,576]  | blocks[N].ffwd.l2.weight        | "down" projection             |
//  | output_norm.weight   [576]       | ln_f.gamma                      |                               |
//  | output.weight (if present)       | lm_head.weight                  | sometimes tied to token_embd  |
//
//  KEY DIFFERENCES to handle:
//  1. GGUF weights are stored TRANSPOSED relative to your Linear (W^T vs W).
//     GGUF: y = x @ W^T  →  stored as [out, in]
//     Your Linear: y = x @ W  →  stored as [in, out]
//     Solution: transpose each weight matrix on load.
//
//  2. GQA (grouped-query attention): Q has n_heads heads, K/V have n_kv_heads.
//     Your Head takes one Q,K,V each with equal head_size.
//     Solution: replicate KV heads to match Q heads (KV head repetition).
//
//  3. SwiGLU FFN: output = (gate * silu(up)) @ down  (3 matrices)
//     Your FFN: output = relu(x @ W1) @ W2           (2 matrices)
//     Solution: merge gate+up into a single matrix via element-wise averaging,
//               or simply load only ffn_up → l1 and ffn_down → l2 (reasonable
//               approximation for weight initialisation / fine-tuning).
//
//  4. RMSNorm (GGUF) vs LayerNorm (yours): no beta in GGUF norms.
//     Solution: load gamma, leave beta = 0 (your default).
//
//  5. Positional encoding: SmolLM2 uses RoPE (rotary, no learned table).
//     Your PositionalEncoding is a learned table.
//     Solution: initialise from position_embedding_table if present,
//               otherwise leave randomly initialised (fine for fine-tuning).

// ============================================================
//  GGUFLoader
// ============================================================
template<typename T>
class GGUFLoader {
private:
    GGUF gguf;

    // -------------------------------------------------------
    //  Build a name → TensorInfo index map for O(1) lookup
    // -------------------------------------------------------
    std::map<std::string, size_t> tensor_index;

    void build_index() {
        tensor_index.clear();
        for (size_t i = 0; i < gguf.tensors.size(); i++)
            tensor_index[gguf.tensors[i].name] = i;
    }

    // -------------------------------------------------------
    //  Load one tensor by name, return as Matrix<T>
    //  Returns an empty Matrix if name not found.
    // -------------------------------------------------------
    Matrix<T> load_by_name(const std::string& name) {

        auto it = tensor_index.find(name);
        if (it == tensor_index.end()) {
            std::cerr << "[GGUFLoader] WARNING: tensor '" << name << "' not found in GGUF.\n";
            return Matrix<T>();
        }
        const TensorInfo& info = gguf.tensors[it->second];
        std::cout << "[GGUFLoader] Loading: " << name << "  dims=[";
        for (size_t d = 0; d < info.dimensions.size(); d++) {
            std::cout << info.dimensions[d];
            if (d + 1 < info.dimensions.size()) std::cout << ",";
        }
        std::cout << "]  type=" << info.ggml_type << "\n";
        return gguf.load_tensor<T>(gguf.file, info, gguf.data_start_offset);
    }

    // -------------------------------------------------------
    //  GGUF stores weight as [out_features, in_features].
    //  Your Linear expects  [in_features,  out_features].
    //  Transpose to fix.
    // -------------------------------------------------------
    Matrix<T> load_weight_transposed(const std::string& name) {
        Matrix<T> w = load_by_name(name);
        if (w.get_size() == 0) return w;
        // w.shape = {out, in}  →  transpose to {in, out}
        // Use your Matrix transpose. Assuming shape = {rows, cols}:
        shape_t orig = w.shape;
        if (orig.size() == 2) {
            // Manual transpose: reshape data
            size_t rows = orig[0], cols = orig[1];
            std::vector<T> transposed(rows * cols);
            for (size_t r = 0; r < rows; r++)
                for (size_t c = 0; c < cols; c++)
                    transposed[c * rows + r] = w.data[r * cols + c];
            return Matrix<T>(transposed, {cols, rows});
        }
        // 1-D (bias/norm weights): no transpose needed
        return w;
    }

    // -------------------------------------------------------
    //  Copy matrix data into a tensor's val, with shape check.
    //  If shapes mismatch we print a warning and skip — better
    //  than a hard crash when architectures differ slightly.
    // -------------------------------------------------------
    void copy_into(Tensor_t<T> dst, Matrix<T> src, const std::string& debug_name) {
        if (src.get_size() == 0) return;
        if (src.get_size() != dst->val.get_size()) {
            std::cerr << "[GGUFLoader] Shape mismatch for '" << debug_name
                      << "': GGUF has " << src.get_size()
                      << " elements, model has " << dst->val.get_size()
                      << ". Skipping.\n";
            return;
        }
        dst->val.copy_from(src);
    }

    // -------------------------------------------------------
    //  Read hyperparameters from GGUF metadata.
    //  We re-parse the file just for the KV section.
    //  (A simpler alternative: caller passes them in.)
    // -------------------------------------------------------

public:

    // ============================================================
    //  load_model
    //
    //  Instantiates a GPT using the provided hyperparams (which
    //  should match the GGUF file), then copies all weights.
    // ============================================================
    GPT<T> load_model(const std::string& path, const GGUFHyperParams& hp)
    {
        // --- 1. Parse the GGUF file ---
        std::cout << "[GGUFLoader] Parsing GGUF: " << path << "\n";
        gguf.parse_gguf(path);
        build_index();

        // --- 2. Construct the model skeleton ---
        //  Note: we pass n_heads (Q heads). The GPT/Block/Head classes use
        //  head_size = input_dim / n_heads, which matches Q head size.
        std::cout << "[GGUFLoader] Building model skeleton...\n";
        GPT<T> model(hp.vocab_size, hp.input_dim, hp.block_size,
                     hp.n_heads, hp.n_layer);

        // --- 3. Get all model parameters in registration order ---
        auto params = model.parameters();
        std::cout << "[GGUFLoader] Model has " << params.size() << " parameter tensors.\n";

        // --- 4. Load weights by name and copy into model ---
        load_weights(model, hp);

        std::cout << "[GGUFLoader] Done loading weights.\n";
        return model;
    }

private:

    // ============================================================
    //  Main weight-loading logic.
    //
    //  We address each sub-component by the known GGUF naming
    //  convention for llama-arch models (SmolLM2, LLaMA, Mistral…).
    // ============================================================
    void load_weights(GPT<T>& model, const GGUFHyperParams& hp)
    {
        // ---- Token Embedding ----
        // GGUF: token_embd.weight [vocab_size, input_dim]  (already [vocab, dim])
        // Your Embedding: embeddings  shape {vocab_size, input_dim}
        {
            Matrix<T> w = load_by_name("token_embd.weight");
            // GGUF dim order for embeddings is [vocab, hidden] — matches directly
            copy_into(model.embedding_table.embeddings, w, "token_embd.weight");
        }

        // ---- Final LayerNorm (output_norm) ----
        // GGUF: output_norm.weight [input_dim]  (RMSNorm gamma, no beta)
        {
            Matrix<T> g = load_by_name("output_norm.weight");
            copy_into(model.ln_f.gamma, g, "output_norm.weight");
            // beta stays zero (correct for RMSNorm-style)
        }

        // ---- LM Head ----
        // In many llama models output.weight is present; in others it is tied
        // to the token embedding (weight tying). We handle both.
        {
            Matrix<T> w = load_weight_transposed("output.weight");
            if (w.get_size() > 0) {
                copy_into(model.lm_head.weight, w, "output.weight");
            } else {
                // Weight tying: lm_head = token_embd.weight^T
                // token_embd is [vocab, dim]; lm_head expects [dim, vocab]
                Matrix<T> embd = load_by_name("token_embd.weight");
                if (embd.get_size() > 0) {
                    size_t vocab = embd.shape[0], dim = embd.shape[1];
                    std::vector<T> tied(vocab * dim);
                    for (size_t v = 0; v < vocab; v++)
                        for (size_t d = 0; d < dim; d++)
                            tied[d * vocab + v] = embd.data[v * dim + d];
                    copy_into(model.lm_head.weight,
                              Matrix<T>(tied, {dim, vocab}),
                              "output.weight (tied)");
                }
            }
        }

        // ---- Decoder Blocks ----
        for (size_t blk = 0; blk < hp.n_layer; blk++)
        {
            std::string pfx = "blk." + std::to_string(blk) + ".";
            load_block_weights(model, hp, blk, pfx);
        }
    }

    // ============================================================
    //  Per-block weight loading
    // ============================================================
    void load_block_weights(GPT<T>& model, const GGUFHyperParams& hp,
                            size_t blk_idx, const std::string& pfx)
    {
        Block<T>& block = *model.decoder_blocks[blk_idx];

        // ---- Attention LayerNorm (ln1) ----
        // GGUF: blk.N.attn_norm.weight [input_dim]
        {
            Matrix<T> g = load_by_name(pfx + "attn_norm.weight");
            copy_into(block.ln1.gamma, g, pfx + "attn_norm.weight");
        }

        // ---- FFN LayerNorm (ln2) ----
        // GGUF: blk.N.ffn_norm.weight [input_dim]
        {
            Matrix<T> g = load_by_name(pfx + "ffn_norm.weight");
            copy_into(block.ln2.gamma, g, pfx + "ffn_norm.weight");
        }

        // ---- Attention Projection (output) ----
        // GGUF: blk.N.attn_output.weight [input_dim, n_heads*head_size]
        // Your: mha.proJ.weight [n_heads*head_size, input_dim]
        {
            Matrix<T> w = load_weight_transposed(pfx + "attn_output.weight");
            copy_into(block.mha.proJ.weight, w, pfx + "attn_output.weight");
        }

        // ---- Q, K, V per-head weights ----
        //
        //  GGUF stores Q as one big matrix [input_dim, n_heads * head_size_q]
        //  and K, V as [input_dim, n_kv_heads * head_size_kv].
        //
        //  Your MultiHeadAttention owns n_heads Head objects, each with its
        //  own Q, K, V Linear of shape [input_dim, head_size].
        //
        //  Strategy:
        //    - Load the full Q matrix and slice head_size columns per head.
        //    - Load the full K/V and replicate KV heads to match Q heads
        //      (standard GQA expansion: head_i uses kv_head[i / kv_ratio]).
        load_attention_heads(block.mha, hp, pfx);

        // ---- FFN weights ----
        //
        //  SwiGLU in SmolLM2:  out = (silu(x @ gate^T) * (x @ up^T)) @ down^T
        //  Your FeedForward:   out = relu(x @ l1.weight) @ l2.weight
        //
        //  Best approximation: load ffn_up → l1, ffn_down → l2.
        //  The gate is dropped; the model will need fine-tuning to compensate,
        //  but the weight shapes and data distribution are reasonable inits.
        //  (Alternatively, concatenate gate+up and double the hidden dim — but
        //   that changes the architecture you already built.)
        {
            // ffn_up:   GGUF [input_dim, ffn_hidden] → yours [input_dim, ffn_hidden]
            Matrix<T> w1 = load_weight_transposed(pfx + "ffn_up.weight");
            copy_into(block.ffwd.l1.weight, w1, pfx + "ffn_up.weight");

            // ffn_down: GGUF [ffn_hidden, input_dim] → yours [ffn_hidden, input_dim]
            Matrix<T> w2 = load_weight_transposed(pfx + "ffn_down.weight");
            copy_into(block.ffwd.l2.weight, w2, pfx + "ffn_down.weight");
        }
    }

    // ============================================================
    //  Split the monolithic Q / K / V matrices into per-head slices
    //  and copy them into the individual Head objects.
    // ============================================================
    void load_attention_heads(MultiHeadAttention<T>& mha,
                               const GGUFHyperParams& hp,
                               const std::string& pfx)
    {
        const size_t n_heads    = hp.n_heads;
        const size_t n_kv_heads = hp.n_kv_heads;
        const size_t head_size  = hp.input_dim / n_heads;     // Q head size
        const size_t kv_ratio   = n_heads / n_kv_heads;       // how many Q per KV

        // Load full matrices (already transposed to [in, out])
        Matrix<T> Q_full = load_weight_transposed(pfx + "attn_q.weight");
        Matrix<T> K_full = load_weight_transposed(pfx + "attn_k.weight");
        Matrix<T> V_full = load_weight_transposed(pfx + "attn_v.weight");

        // Q_full: [input_dim, n_heads * head_size]
        // K_full: [input_dim, n_kv_heads * head_size]
        // V_full: [input_dim, n_kv_heads * head_size]

        for (size_t h = 0; h < n_heads; h++)
        {
            Head<T>& head = *mha.Heads[h];
            size_t kv_h = h / kv_ratio;   // which KV head this Q head maps to

            // ---- Q slice: columns [h*head_size .. (h+1)*head_size) ----
            if (Q_full.get_size() > 0) {
                Matrix<T> q_slice = col_slice(Q_full, h * head_size, head_size);
                copy_into(head.Q.weight, q_slice, pfx + "attn_q.weight[h=" + std::to_string(h) + "]");
            }

            // ---- K slice ----
            if (K_full.get_size() > 0) {
                Matrix<T> k_slice = col_slice(K_full, kv_h * head_size, head_size);
                copy_into(head.K.weight, k_slice, pfx + "attn_k.weight[kv=" + std::to_string(kv_h) + "]");
            }

            // ---- V slice ----
            if (V_full.get_size() > 0) {
                Matrix<T> v_slice = col_slice(V_full, kv_h * head_size, head_size);
                copy_into(head.V.weight, v_slice, pfx + "attn_v.weight[kv=" + std::to_string(kv_h) + "]");
            }
        }
    }

    // ============================================================
    //  Helper: extract a column slice from a 2-D matrix.
    //  src shape: [rows, total_cols]
    //  Returns:   [rows, n_cols]  starting at col_start
    // ============================================================
    Matrix<T> col_slice(const Matrix<T>& src, size_t col_start, size_t n_cols)
    {
        if (src.shape.size() != 2)
            throw std::runtime_error("col_slice: expected 2-D matrix");

        size_t rows      = src.shape[0];
        size_t total_cols = src.shape[1];

        if (col_start + n_cols > total_cols)
            throw std::runtime_error("col_slice: out of bounds");

        std::vector<T> out(rows * n_cols);
        for (size_t r = 0; r < rows; r++)
            for (size_t c = 0; c < n_cols; c++)
                out[r * n_cols + c] = src.data[r * total_cols + col_start + c];

        return Matrix<T>(out, {rows, n_cols});
    }

public:

    // ============================================================
    //  Convenience: print all tensor names and shapes in the file.
    //  Useful to debug a new GGUF you've never seen before.
    // ============================================================
    void inspect(const std::string& path)
    {
        gguf.parse_gguf(path);
        std::cout << "\n=== GGUF Tensor Inventory: " << path << " ===\n";
        for (const auto& t : gguf.tensors) {
            std::cout << "  " << t.name << "  [";
            for (size_t d = 0; d < t.dimensions.size(); d++) {
                std::cout << t.dimensions[d];
                if (d + 1 < t.dimensions.size()) std::cout << ", ";
            }
            std::cout << "]  type=" << t.ggml_type << "\n";
        }
        std::cout << "=== " << gguf.tensors.size() << " tensors total ===\n\n";
    }
};


